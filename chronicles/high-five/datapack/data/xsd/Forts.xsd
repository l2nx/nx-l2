<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:simpleType name="name">
		<xs:restriction base="xs:string">
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="siegeGuard">
		<xs:attribute name="npcId" type="xs:positiveInteger" use="required" />
		<xs:attribute name="x" type="xs:integer" use="required" />
		<xs:attribute name="y" type="xs:integer" use="required" />
		<xs:attribute name="z" type="xs:integer" use="required" />
		<xs:attribute name="heading" type="xs:integer" use="required" />
		<!-- Seconds, 0 does not respawn. -->
		<xs:attribute name="respawnDelay" type="xs:nonNegativeInteger" use="required" />
	</xs:complexType>
	<xs:complexType name="spawn">
		<!-- 0 always spawned, 1 commanders (despawned during the siege), 2 despawned before the siege, 3 special envoys (spawned after the fort is taken). -->
		<xs:attribute name="type" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="0" />
					<xs:maxInclusive value="3" />
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="npcId" type="xs:positiveInteger" use="required" />
		<xs:attribute name="x" type="xs:integer" use="required" />
		<xs:attribute name="y" type="xs:integer" use="required" />
		<xs:attribute name="z" type="xs:integer" use="required" />
		<xs:attribute name="heading" type="xs:integer" use="required" />
		<!-- Type 3 only: the castle the envoy offers a contract with. -->
		<xs:attribute name="castleId" type="xs:positiveInteger" />
	</xs:complexType>
	<xs:element name="list">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="fort" minOccurs="1" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="siegeGuard" type="siegeGuard" minOccurs="0" maxOccurs="unbounded" />
							<xs:element name="spawn" type="spawn" minOccurs="0" maxOccurs="unbounded" />
						</xs:sequence>
						<xs:attribute name="id" type="xs:positiveInteger" use="required" />
						<xs:attribute name="name" type="name" use="required" />
						<!-- 0 small, 1 large. -->
						<xs:attribute name="type" use="required">
							<xs:simpleType>
								<xs:restriction base="xs:integer">
									<xs:minInclusive value="0" />
									<xs:maxInclusive value="1" />
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
		<xs:unique name="uniqueFort">
			<xs:selector xpath="fort" />
			<xs:field xpath="@id" />
		</xs:unique>
	</xs:element>
</xs:schema>
