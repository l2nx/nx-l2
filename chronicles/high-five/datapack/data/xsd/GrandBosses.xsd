<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="list">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="boss" minOccurs="1" maxOccurs="unbounded">
					<!-- A boss without a spawn point is placed by its script only. -->
					<xs:complexType>
						<xs:attribute name="id" type="xs:positiveInteger" use="required" />
						<xs:attribute name="x" type="xs:integer" />
						<xs:attribute name="y" type="xs:integer" />
						<xs:attribute name="z" type="xs:integer" />
						<xs:attribute name="heading" type="xs:integer" />
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
		<xs:unique name="uniqueBoss">
			<xs:selector xpath="boss" />
			<xs:field xpath="@id" />
		</xs:unique>
	</xs:element>
</xs:schema>
